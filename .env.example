# Copy to .env and fill real values on the server only.
# Never commit real passwords.

MAIL_FROM_NAME=Example Sender Name
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_REPLY_TO=noreply@example.com
SMTP_HOST=smtps.example.com
SMTP_PORT=465
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_SECURITY=ssl

LICENSE_ADMIN_KEY=change-me-admin-key
LICENSE_DB_PATH=./license_api/licenses.db
LICENSE_API_URL=http://127.0.0.1:8090

# Ed25519 — production VPS uses PATH (32-byte raw file); HEX is optional fallback
LICENSE_ED25519_PRIVATE_KEY_PATH=
LICENSE_ED25519_PRIVATE_KEY_HEX=

# PayPal Website Payments Standard
PAYPAL_BUSINESS_EMAIL=ballestrinofrancisco@gmail.com
PAYPAL_IPN_VERIFY_URL=https://www.paypal.com/cgi-bin/webscr
# Checkout form action (use https://www.sandbox.paypal.com/cgi-bin/webscr for sandbox)
PAYPAL_CHECKOUT_URL=https://www.paypal.com/cgi-bin/webscr
NEXT_PUBLIC_PAYPAL_CHECKOUT_URL=https://www.paypal.com/cgi-bin/webscr

# Public site URL (IPN notify_url, return URLs, order emails)
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Protected commercial installers (NOT in public/)
PRIVATE_INSTALLERS_DIR=./private/downloads

# Demo download analytics (SQLite — no raw IP stored)
DEMO_ANALYTICS_DB_PATH=./data/demo_download_events.db

# Admin dashboard session (optional dedicated secret; otherwise derived server-side from LICENSE_ADMIN_KEY)
ADMIN_SESSION_SECRET=

# HMAC secret for analytics dedupe (recommended distinct from LICENSE_ADMIN_KEY)
ANALYTICS_HMAC_SECRET=

# Trust nginx-set client IP headers (X-Real-IP / X-Forwarded-For). Set to 1 only behind nginx.
TRUST_PROXY=0

# Trust geo country headers from reverse proxy/CDN. Set to 1 only when nginx/CDN overwrites them.
TRUSTED_PROXY_GEO=0
TRUSTED_GEO_HEADER=x-geo-country
TRUSTED_GEO_REGION_HEADER=

# Optional local MaxMind GeoLite2-Country.mmdb (preferred for Ubuntu/nginx VPS without CDN geo)
GEOIP_DB_PATH=
